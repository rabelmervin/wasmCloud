package kompilre:compiler@0.1.0;

interface compiler-api {
    record entity-file {
        name: string,
        content: string,
    }

    /// Hostname + database for an app that does not have a workload yet. Present only on
    /// an onboarding request; absent for every schema change. When absent and no workload
    /// carries the app-id, the deploy is REFUSED rather than provisioning something — so a
    /// plain compile can never create a tenant.
    record provision-spec {
        host: string,
        db-url: string,
    }

    /// Receive generated entity .rs files, run wash build, push to OCI, then either patch
    /// the app's existing workload or — with `provision` — create it.
    compile-and-deploy: func(
        files: list<entity-file>,
        registry-url: string,
        app-id: string,
        provision: option<provision-spec>,
    ) -> result<string, string>;
}

/// Host-side world: the host (wash-runtime plugin) fulfils these imports
/// for any WASM component that imports kompilre:compiler/compiler-api.
world compiler-host {
    import compiler-api;
}
